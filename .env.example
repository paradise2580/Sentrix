# Copy this file to .env and fill in real values.
# .env is git-ignored. config.yaml is NOT — so no secret may live there.

# ---- MySQL ----
# MYSQL_PASSWORD is REQUIRED: it has no config.yaml fallback on purpose,
# and src/ingestion/db.py fails fast with an instruction if it is missing.
# The rest override config.yaml defaults only if you set them.
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=sentrix_user
MYSQL_DATABASE=sentrix

# ---- External signals ----
# FRED (free: https://fred.stlouisfed.org/docs/api/api_key.html) enables the
# REAL daily commodity series. Without it the commodity signal falls back to
# a generated one, flagged is_synthetic = 1 in the database.
FRED_API_KEY=

# Unused by the current pipeline — kept because scraper.py can pull live
# signals for a present-day deployment, where date alignment is not an issue.
NEWSAPI_KEY=
OPENWEATHER_KEY=

# ---- LLM (RAG chat) ----
# Free tier: https://console.groq.com. Without it, /chat returns retrieval
# results without a generated answer; everything else runs unaffected.
GROQ_API_KEY=

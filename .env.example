# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real keys.

# MySQL (overrides config.yaml if set)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=sentrix_user
MYSQL_PASSWORD=sentrix_pass
MYSQL_DATABASE=sentrix

# External signal APIs (used by src/ingestion/scraper.py)
NEWSAPI_KEY=your_newsapi_key_here
OPENWEATHER_KEY=your_openweathermap_key_here
FRED_API_KEY=your_fred_api_key_here

# LLM (used by src/rag/chain.py)
GROQ_API_KEY=your_groq_api_key_here

# SENTRIX dashboard — serving image.
#
# Holds no business logic: every number comes from an HTTP call to the API,
# so this image needs no model artifacts and no database access at all.

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements-serve.txt .
RUN pip install --no-cache-dir -r requirements-serve.txt

COPY config/ ./config/
COPY src/config_loader.py src/logger.py src/exception.py ./src/
COPY src/__init__.py ./src/
COPY frontend/ ./frontend/

EXPOSE 8501

# SENTRIX_API_BASE points this at the deployed API; see frontend/dashboard.py.
CMD ["sh", "-c", "streamlit run frontend/dashboard.py --server.port=${PORT:-8501} --server.address=0.0.0.0 --server.headless=true"]

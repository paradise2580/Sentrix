# Environments
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Secrets — never commit
.env

# Raw + processed data: DVC-tracked, not git-tracked. Only the small .dvc
# pointer files belong in the repo. data/serving/ is the exception — it is
# the few-thousand-row SQLite snapshot the deployed API reads.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/raw/*.dvc
!data/processed/*.dvc

# Model binaries and caches are not git-tracked...
artifacts/*
!artifacts/.gitkeep
# ...but the evaluation RESULTS are. They are a few KB of CSV and they let
# anyone reading this repo see the model comparison, the reliability curve
# and the cost curve without standing up MySQL and retraining first.
!artifacts/evaluation/
artifacts/evaluation/*
!artifacts/evaluation/*.csv
!artifacts/evaluation/*.joblib

# The serving tier ships with the repo. These three are what the deployed
# API actually reads, and none of them is a model binary:
#   preprocessor.joblib  6 KB   the fitted transform, needed to score
#   chroma/              ~10 MB the vector index for RAG retrieval
# Committing them is what lets the deployment need no database server and
# no model download at boot.
!artifacts/preprocessor.joblib
!artifacts/chroma/
!artifacts/chroma/**

# MLflow — both the configured store and the ./mlruns directory MLflow
# creates in the working directory when an experiment has no explicit
# artifact_location. The latter is ~100MB of pickled models.
mlruns/
artifacts/mlruns/
*.db
# ...except the serving snapshot, which is the whole point of the deployment.
!data/serving/*.db

# Logs and local run artifacts
logs/*
!logs/.gitkeep
train.log
*.zip

# OS / IDE
.DS_Store
.idea/
.vscode/

# Jupyter checkpoints
.ipynb_checkpoints/

# Run logs from the order-grain rebuild � scratch, not project output
*-run.log
